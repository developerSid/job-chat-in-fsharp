{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "Run csharpier",
      "command": "dotnet",
      "args": [
        "csharpier",
        "format",
        "${staged}"
      ],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.xml",
        "**/*.config"
      ],
      "exclude": [
        ".paket/Paket.Restore.targets"
      ]
    },
    {
      "name": "Run fantomas",
      "command": "dotnet",
      "args": [
        "fantomas",
        "${staged}"
      ],
      "include": [
        "**/*.fs",
        "**/*.fsx"
      ]
    },
    {
      "name": "Run compiler",
      "command": "dotnet",
      "args": [
        "build",
        "--no-restore",
        "--verbosity",
        "quiet"
      ]
    },
    {
      "name": "Run tests",
      "command": "dotnet",
      "args": [
        "test"
      ]
    }
  ]
}
